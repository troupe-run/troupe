{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --no-project python \"${CLAUDE_PROJECT_DIR}/scripts/guard.py\" claude-session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --no-project python \"${CLAUDE_PROJECT_DIR}/scripts/guard.py\" claude-pre-tool-use",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --no-project python \"${CLAUDE_PROJECT_DIR}/scripts/guard.py\" claude-pre-tool-use",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
