{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://troupe.run/protocol/client/flush-result.schema.json",
  "title": "flush: result",
  "description": "What was done, or would be, to each config file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "files",
    "notices"
  ],
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "$ref": "config.schema.json#/$defs/file"
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "$ref": "../notice.schema.json"
      }
    }
  }
}
