{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://troupe.run/protocol/events/run-ended.schema.json",
  "title": "Run.Ended",
  "description": "The payload of a run's last event (topic troupe.core.runs.aggregate:Run.Ended): the outcome the run host derived, with what the audit of the run's changes found, and whether recording failed part-way.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lineage",
    "timestamp",
    "outcome"
  ],
  "properties": {
    "lineage": {
      "$ref": "../lineage.schema.json"
    },
    "timestamp": {
      "$ref": "../event-record.schema.json#/$defs/libraryTimestamp"
    },
    "outcome": {
      "description": "How the run ended, as the run host derived it from what the runner reported, never from its exit code alone: the outcome, whether the runner exited, was killed or never started, the limits it ran under, and what the audit of its changes found.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "ending",
        "limits"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "succeeded",
            "failed",
            "cancelled",
            "timed-out",
            "crashed",
            "could-not-start"
          ]
        },
        "error": {
          "description": "Why the run didn't succeed. Absent: the outcome has no error.",
          "$ref": "../error.schema.json"
        },
        "result": {
          "description": "The result event the runner sent. Absent: it sent none, or never started.",
          "$ref": "../runner/run-event.schema.json#/$defs/result"
        },
        "exitCode": {
          "description": "The runner process's exit code. Present exactly when the runner started (ending isn't never-started).",
          "type": "integer"
        },
        "ending": {
          "enum": [
            "exited",
            "killed",
            "never-started"
          ]
        },
        "transcript": {
          "description": "The transcript's artifact reference. Present exactly when the runner started.",
          "$ref": "../lineage.schema.json#/$defs/hash"
        },
        "transcriptFormat": {
          "description": "How the transcript's lines are written. native: each line is a record as the runner sent it. kinds: the runner accepted transcript-kinds, and each line is a record with its kind (transcript-record.schema.json). Present exactly when the runner started.",
          "$ref": "#/$defs/transcriptFormat"
        },
        "stderr": {
          "description": "The artifact reference of the runner's standard error. Present exactly when the runner started.",
          "$ref": "../lineage.schema.json#/$defs/hash"
        },
        "audit": {
          "description": "What the audit of the run's changes against its actor's declared effects found, whatever the outcome. Present exactly when the runner started.",
          "$ref": "#/$defs/audit"
        },
        "limits": {
          "description": "The limits the run ran under, by setting.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_timeout",
            "run_timeout",
            "cancel_grace",
            "silence_announce",
            "max_message_bytes",
            "event_max_bytes",
            "transcript_max_bytes",
            "stderr_max_bytes",
            "fail_fast_on_auth_retry"
          ],
          "properties": {
            "start_timeout": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "run_timeout": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "cancel_grace": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "silence_announce": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_message_bytes": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "event_max_bytes": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "transcript_max_bytes": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "stderr_max_bytes": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "fail_fast_on_auth_retry": {
              "type": "boolean"
            }
          }
        }
      },
      "if": {
        "properties": {
          "ending": {
            "const": "never-started"
          }
        }
      },
      "then": {
        "properties": {
          "exitCode": false,
          "transcript": false,
          "transcriptFormat": false,
          "stderr": false,
          "result": false,
          "audit": false
        }
      },
      "else": {
        "required": [
          "exitCode",
          "transcript",
          "transcriptFormat",
          "stderr",
          "audit"
        ]
      }
    },
    "recording": {
      "description": "What wasn't recorded first, and why: the first run event, by its seq, or a notice troupe raised for the run, by its code. Absent: recording didn't fail.",
      "$ref": "#/$defs/recording"
    },
    "changes": {
      "description": "What a worktree run changed, captured when it ended. Present exactly when the run's workspace was a worktree.",
      "$ref": "#/$defs/changes"
    }
  },
  "$defs": {
    "transcriptFormat": {
      "title": "Transcript format",
      "description": "native: each line of the transcript is a record as the runner sent it. kinds: each line is a record with its kind (transcript-record.schema.json).",
      "enum": [
        "native",
        "kinds"
      ]
    },
    "shared": {
      "title": "Shared changes",
      "description": "What changed during the run in the state the repository's worktrees share, which discarding doesn't undo. Each list is left out when nothing in it changed.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "refs": {
          "description": "Each of the refs, the stash and the theatre's HEAD that changed. Absent: none did.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "change"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "change": {
                "enum": [
                  "added",
                  "changed",
                  "removed"
                ]
              }
            }
          },
          "minItems": 1
        },
        "config": {
          "description": "Each of the repository's config files that changed. Absent: none did.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "change"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "change": {
                "enum": [
                  "added",
                  "changed",
                  "removed"
                ]
              }
            }
          },
          "minItems": 1
        },
        "hooks": {
          "description": "Each of the hooks, in the hooks directory git uses that changed. Absent: none did.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "change"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "change": {
                "enum": [
                  "added",
                  "changed",
                  "removed"
                ]
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "changes": {
      "title": "Captured changes",
      "description": "A worktree run's changes against its base commit: the diff's reference with the counts of files it adds, modifies and deletes, and how many paths under .troupe/ were left out; or, when capturing failed, the error. diff is absent when nothing changed.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "added",
            "modified",
            "deleted",
            "leftOut"
          ],
          "properties": {
            "diff": {
              "description": "The diff's artifact reference: git's binary diff from the base commit. Absent: the run changed nothing.",
              "$ref": "../lineage.schema.json#/$defs/hash"
            },
            "added": {
              "type": "integer",
              "minimum": 0
            },
            "modified": {
              "type": "integer",
              "minimum": 0
            },
            "deleted": {
              "type": "integer",
              "minimum": 0
            },
            "leftOut": {
              "description": "How many changed paths under .troupe/ were left out of the diff.",
              "type": "integer",
              "minimum": 0
            },
            "shared": {
              "description": "What changed in the repository's shared state during the run. Absent: nothing did.",
              "$ref": "#/$defs/shared"
            }
          },
          "if": {
            "properties": {
              "added": {
                "const": 0
              },
              "modified": {
                "const": 0
              },
              "deleted": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "diff": false
            }
          },
          "else": {
            "required": [
              "diff"
            ]
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "error"
          ],
          "properties": {
            "error": {
              "description": "Why the changes couldn't be captured. The worktree is kept.",
              "$ref": "../error.schema.json"
            },
            "shared": {
              "description": "What changed in the repository's shared state during the run. Absent: nothing did.",
              "$ref": "#/$defs/shared"
            }
          }
        }
      ]
    },
    "audit": {
      "title": "Audit",
      "description": "What the audit of a run's changes found: each change its actor's declared effects don't allow, in path order (none when every change was declared); or, when the audit couldn't read the workspace, the error.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outside"
          ],
          "properties": {
            "outside": {
              "description": "Each change outside the declaration, in path order. Empty: every change was declared.",
              "type": "array",
              "items": {
                "$ref": "../effects.schema.json#/$defs/change"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "error"
          ],
          "properties": {
            "error": {
              "description": "Why the audit couldn't run.",
              "$ref": "../error.schema.json"
            }
          }
        }
      ]
    },
    "recording": {
      "title": "Recording failure",
      "oneOf": [
        {
          "title": "A run event wasn't recorded",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "failedAt",
            "error"
          ],
          "properties": {
            "failedAt": {
              "description": "The seq of the first run event that wasn't recorded.",
              "type": "integer",
              "minimum": 0
            },
            "error": {
              "$ref": "../error.schema.json"
            }
          }
        },
        {
          "title": "A notice wasn't recorded",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "notice",
            "error"
          ],
          "properties": {
            "notice": {
              "description": "The code of the notice that wasn't recorded, before any run event failed to be.",
              "$ref": "../notice.schema.json#/$defs/fields/properties/code"
            },
            "error": {
              "$ref": "../error.schema.json"
            }
          }
        }
      ]
    }
  }
}
