{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://troupe.run/protocol/notice.schema.json",
  "title": "Notice",
  "description": "Something a person should know while troupe works, such as a wait or a retry, as structured data. It has the same fields as an error; each surface renders it in its own words, and the code identifies it. Every code troupe can produce is listed, with what its details hold.",
  "$ref": "#/$defs/fields",
  "unevaluatedProperties": false,
  "oneOf": [
    {
      "required": [
        "details"
      ],
      "properties": {
        "code": {
          "const": "run.silent"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seconds"
          ],
          "properties": {
            "seconds": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    {
      "required": [
        "details"
      ],
      "properties": {
        "code": {
          "const": "run.retrying"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attempt",
            "delayMs",
            "reason"
          ],
          "properties": {
            "attempt": {
              "type": "integer",
              "minimum": 1
            },
            "maxAttempts": {
              "description": "How many attempts the engine will make in all. Absent: the runner didn't say.",
              "type": "integer",
              "minimum": 1
            },
            "delayMs": {
              "type": "integer",
              "minimum": 0
            },
            "reason": {
              "$ref": "runner/run-event.schema.json#/$defs/retry/properties/reason"
            }
          }
        }
      }
    },
    {
      "required": [
        "details"
      ],
      "properties": {
        "code": {
          "const": "events.other-branch"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session"
          ],
          "properties": {
            "branch": {
              "description": "The branch the left-out segment was written on. Absent: it was written with no branch (a detached HEAD).",
              "type": "string",
              "minLength": 1
            },
            "session": {
              "$ref": "lineage.schema.json#/$defs/ulid"
            }
          }
        }
      }
    },
    {
      "required": [
        "details"
      ],
      "properties": {
        "code": {
          "const": "events.order-rebuilt"
        },
        "details": {
          "oneOf": [
            {
              "description": "Events the order named are no longer here.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "gone"
              ],
              "properties": {
                "gone": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            {
              "description": "The order wasn't consistent: two processes numbered events at once (troupe-run/troupe#450).",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "line",
                "conflict"
              ],
              "properties": {
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "conflict": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      }
    },
    {
      "required": [
        "details"
      ],
      "properties": {
        "code": {
          "const": "events.order-repaired"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repeats"
          ],
          "properties": {
            "repeats": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    {
      "required": [
        "details"
      ],
      "properties": {
        "code": {
          "const": "events.incomplete-batch"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "line"
          ],
          "properties": {
            "line": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    {
      "required": [
        "details"
      ],
      "properties": {
        "code": {
          "const": "events.subscription-polling"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason",
            "detail",
            "pollSeconds"
          ],
          "properties": {
            "reason": {
              "description": "Why the store polls: the platform refused the watch, or the watch accepted but missed a write.",
              "enum": [
                "watch-refused",
                "watch-missed-write"
              ]
            },
            "detail": {
              "description": "What the platform said, or what was missed, in its own words.",
              "type": "string",
              "minLength": 1
            },
            "pollSeconds": {
              "description": "How often the store looks for new events instead.",
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    {
      "required": [
        "details"
      ],
      "properties": {
        "code": {
          "const": "run.cancelling"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "presses"
          ],
          "properties": {
            "presses": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    {
      "required": [
        "details"
      ],
      "properties": {
        "code": {
          "const": "run.interrupted"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run"
          ],
          "properties": {
            "run": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    {
      "required": [
        "details"
      ],
      "properties": {
        "code": {
          "const": "run.unfinished-elsewhere"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run"
          ],
          "properties": {
            "run": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "config.file-rewritten"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason"
          ],
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "resolved": {
              "description": "Present when git's index held the file unmerged from versions troupe wrote, and troupe marked it resolved.",
              "const": true
            }
          }
        }
      },
      "required": [
        "details"
      ]
    },
    {
      "properties": {
        "code": {
          "const": "config.merge-rewritten"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "merge",
            "action",
            "kept",
            "resolved"
          ],
          "properties": {
            "merge": {
              "description": "How git merged the file: it left it conflicted, or merged it cleanly.",
              "enum": [
                "conflicted",
                "clean"
              ]
            },
            "action": {
              "description": "What troupe did to it, as the merged config says.",
              "enum": [
                "write",
                "remove"
              ]
            },
            "kept": {
              "description": "The artifact the file's bytes were kept under before troupe replaced it.",
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "resolved": {
              "description": "Whether troupe marked the file resolved in git's index, so the merge can be committed with no git add.",
              "type": "boolean"
            },
            "unresolved": {
              "description": "Why troupe didn't mark a conflicted file resolved: the setting mark_merges_resolved is off, policy forbids it, git's index changed after troupe read it, git failed, or the VCS has no index. Absent when it was marked, and for a clean merge.",
              "enum": [
                "setting",
                "policy",
                "index-changed",
                "failed",
                "no-index"
              ]
            }
          }
        }
      },
      "required": [
        "details"
      ]
    },
    {
      "properties": {
        "code": {
          "const": "config.waiting"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "waitedSeconds"
          ],
          "properties": {
            "waitedSeconds": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      },
      "required": [
        "details"
      ]
    },
    {
      "required": [
        "details"
      ],
      "properties": {
        "code": {
          "const": "config.hand-edit-recorded"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "entries"
          ],
          "properties": {
            "file": {
              "description": "The config file, relative to the theatre.",
              "type": "string",
              "minLength": 1
            },
            "change": {
              "description": "The change id the sweep's changes share. Absent: a rehearsal, which records nothing.",
              "type": "string",
              "minLength": 1
            },
            "entries": {
              "type": "integer",
              "minimum": 1
            },
            "rehearsal": {
              "description": "Present when a rehearsal reports what the real command would do; it did none of it.",
              "const": true
            },
            "removed": {
              "description": "Present when the file went missing, recorded as removing what it held.",
              "const": true
            }
          }
        }
      }
    },
    {
      "required": [
        "details"
      ],
      "properties": {
        "code": {
          "const": "config.conflict-resolved"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "file",
            "changes"
          ],
          "properties": {
            "path": {
              "description": "The config path, as keys.",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "file": {
              "description": "The config file, relative to the theatre.",
              "type": "string",
              "minLength": 1
            },
            "value": {
              "description": "The value the hand edit took, as config holds it. Absent: the hand edit unset the value (unset is true).",
              "$ref": "events/config-changed.schema.json#/$defs/value"
            },
            "unset": {
              "description": "Present when the hand edit unset the value, by deleting its file.",
              "const": true
            },
            "changes": {
              "description": "The ids of the changes that were in conflict.",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "rehearsal": {
              "description": "Present when a rehearsal reports what the real command would do; it did none of it.",
              "const": true
            }
          }
        }
      }
    },
    {
      "required": [
        "details"
      ],
      "properties": {
        "code": {
          "const": "config.hand-edit-unrecorded"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "files",
            "left"
          ],
          "properties": {
            "files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "left": {
              "description": "The conflicting paths no hand edit sets.",
              "type": "array",
              "items": {
                "description": "The config path, as keys.",
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "workspace.waiting"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "waitedSeconds"
          ],
          "properties": {
            "operation": {
              "type": "string",
              "minLength": 1
            },
            "waitedSeconds": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      },
      "required": [
        "details"
      ]
    },
    {
      "properties": {
        "code": {
          "const": "workspace.uncommitted-unseen"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "paths",
            "base"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "paths": {
              "description": "The first of them, up to UNCOMMITTED_NOTICE_PATHS, relative to the repository's top level.",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "base": {
              "$ref": "events/run-started.schema.json#/$defs/commit"
            }
          }
        }
      },
      "required": [
        "details"
      ]
    },
    {
      "properties": {
        "code": {
          "const": "workspace.shared-git-changed"
        },
        "details": {
          "$ref": "events/run-ended.schema.json#/$defs/shared"
        }
      },
      "required": [
        "details"
      ]
    },
    {
      "properties": {
        "code": {
          "const": "workspace.not-removed"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "worktree"
          ],
          "properties": {
            "worktree": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "required": [
        "details"
      ]
    },
    {
      "properties": {
        "code": {
          "const": "run.scratch-not-removed"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scratch"
          ],
          "properties": {
            "scratch": {
              "description": "The scratch directory that's left, as an absolute path on this machine.",
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "required": [
        "details"
      ]
    },
    {
      "properties": {
        "code": {
          "const": "run.estimate-dropped"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runner"
          ],
          "properties": {
            "runner": {
              "description": "The runner's name, as its init event gave it.",
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "required": [
        "details"
      ]
    },
    {
      "description": "troupe init --audition has started preparing a runner's engine outside any run, which can take tens of seconds, up to RUNNER_WARM_UP_TIMEOUT_SECONDS. Sent as it starts, so nobody waits on it silently.",
      "properties": {
        "code": {
          "const": "runner.warming-up"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runner"
          ],
          "properties": {
            "runner": {
              "description": "The runner's name.",
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "required": [
        "details"
      ]
    },
    {
      "description": "A runner's engine was prepared outside any run, by troupe init --audition, so its first run starts quickly.",
      "properties": {
        "code": {
          "const": "runner.warmed-up"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runner",
            "seconds"
          ],
          "properties": {
            "runner": {
              "description": "The runner's name.",
              "type": "string",
              "minLength": 1
            },
            "seconds": {
              "description": "How long it took, or the limit it reached, in seconds.",
              "type": "number",
              "minimum": 0
            }
          }
        }
      },
      "required": [
        "details"
      ]
    },
    {
      "description": "A runner couldn't prepare its engine outside any run. The problem and fix are the runner's own, when it gave them, such as a macOS Python mistral.rs can't compile its Metal kernels under.",
      "properties": {
        "code": {
          "const": "runner.warm-up-failed"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runner"
          ],
          "properties": {
            "runner": {
              "description": "The runner's name.",
              "type": "string",
              "minLength": 1
            },
            "code": {
              "description": "The error code the runner gave, such as mistralrs.unsupported-python. Absent: it gave none.",
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "required": [
        "details"
      ]
    },
    {
      "description": "Preparing a runner's engine passed RUNNER_WARM_UP_TIMEOUT_SECONDS and was stopped. What it did is kept, and the first run's own check finishes it.",
      "properties": {
        "code": {
          "const": "runner.warm-up-cut-off"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runner",
            "seconds"
          ],
          "properties": {
            "runner": {
              "description": "The runner's name.",
              "type": "string",
              "minLength": 1
            },
            "seconds": {
              "description": "How long it took, or the limit it reached, in seconds.",
              "type": "number",
              "minimum": 0
            }
          }
        }
      },
      "required": [
        "details"
      ]
    },
    {
      "properties": {
        "code": {
          "const": "config.present-unreadable"
        },
        "details": false
      }
    },
    {
      "required": [
        "details"
      ],
      "properties": {
        "code": {
          "const": "config.edit-abandoned"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "change",
            "files",
            "changes",
            "droppable"
          ],
          "properties": {
            "change": {
              "description": "The change id of the sweep that put the files back: what troupe config drop and troupe config keep name.",
              "type": "string",
              "minLength": 1
            },
            "files": {
              "description": "The config files whose values went back, relative to the theatre.",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "changes": {
              "description": "The change ids of the round trip, first to last, each once.",
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "droppable": {
              "description": "Whether troupe config drop can remove them now.",
              "type": "boolean"
            },
            "reason": {
              "description": "Present when they can't be dropped: changes-more (one of them changes other values too), built-on (a later change follows them), run (a run used them, or the run this command starts will), committed, shares-segment (their event file holds other events).",
              "enum": [
                "changes-more",
                "built-on",
                "run",
                "committed",
                "shares-segment"
              ]
            },
            "blocker": {
              "description": "The change id (changes-more, built-on) or run id (run) that blocks the drop. Absent: no one thing does, or it's the run this command is about to start.",
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "config.kept-unreadable"
        },
        "details": false
      }
    }
  ],
  "$defs": {
    "fields": {
      "title": "Notice fields",
      "description": "The fields every notice has: the same as an error's.",
      "type": "object",
      "required": [
        "code",
        "problem",
        "fix"
      ],
      "properties": {
        "code": {
          "title": "Code",
          "description": "Stable, dotted identifier for this kind of notice, such as run.silent. Surfaces use it to recognise and rephrase the notice.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
        },
        "problem": {
          "title": "Problem",
          "description": "What is happening.",
          "type": "string",
          "minLength": 1
        },
        "fix": {
          "title": "Fix",
          "description": "What the person can do about it, if anything.",
          "type": "string",
          "minLength": 1
        },
        "path": {
          "title": "Path",
          "description": "The absolute path of the file or directory concerned, when there is one.",
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
