{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://troupe.run/protocol/client/perform-update.schema.json",
  "title": "perform: update",
  "description": "Sent while perform runs, before its result: the performance once its start is recorded, the run id once it is minted, each run event as it is recorded, and each notice.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "performanceId",
        "performed",
        "steps"
      ],
      "properties": {
        "kind": {
          "const": "performance-started"
        },
        "performanceId": {
          "$ref": "../lineage.schema.json#/$defs/performanceId"
        },
        "performed": {
          "description": "What the performance performs: an actor or a flow, by its name.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "enum": [
                "actor",
                "flow"
              ]
            },
            "name": {
              "$ref": "run.schema.json#/$defs/actorName"
            }
          }
        },
        "steps": {
          "description": "How many steps the performance has: one for an actor, a flow's number of steps.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "runId",
        "performanceId",
        "step",
        "actor"
      ],
      "properties": {
        "kind": {
          "const": "started"
        },
        "runId": {
          "$ref": "run.schema.json#/$defs/runId"
        },
        "performanceId": {
          "description": "The performance the run is a step of.",
          "$ref": "../lineage.schema.json#/$defs/performanceId"
        },
        "step": {
          "description": "The run's step in its performance, counting from 1.",
          "type": "integer",
          "minimum": 1
        },
        "actor": {
          "description": "The actor the step runs.",
          "$ref": "run.schema.json#/$defs/actorName"
        },
        "worktree": {
          "description": "The run's worktree, relative to the theatre, where it works. Absent: the run works in the theatre.",
          "$ref": "run.schema.json#/$defs/theatrePath"
        }
      }
    },
    {
      "$ref": "run.schema.json#/$defs/loggedEvent"
    },
    {
      "$ref": "run.schema.json#/$defs/noticeUpdate"
    }
  ]
}
