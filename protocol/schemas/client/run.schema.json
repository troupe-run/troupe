{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://troupe.run/protocol/client/run.schema.json",
  "title": "Run",
  "description": "Definitions the client protocol's run messages share: run ids, what perform is asked to run, a run's summary as status and logs report it, and one recorded run event.",
  "$defs": {
    "runId": {
      "title": "Run id",
      "description": "A UUID in canonical lowercase form, minted by perform.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "runRef": {
      "title": "Run reference",
      "description": "A run's full id, or a prefix of at least 8 hex digits that matches exactly one run.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}[0-9a-f-]{0,28}$"
    },
    "actorName": {
      "title": "Actor name",
      "description": "The actor's name. It becomes the agent's id in lineage.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "runnerName": {
      "title": "Runner name",
      "description": "A runner troupe knows by name. A request never carries a command line.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "theatrePath": {
      "title": "Theatre-relative path",
      "description": "A path relative to the theatre's root, with / separators. Never a host path, a drive, or a path that leaves the theatre with ..",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*\\\\)(?!(.*/)?\\.\\.(/|$)).+$"
    },
    "effectCheck": {
      "title": "Effect check",
      "description": "How troupe checks, after a run, that it did what it was for. There is no default: none must be said explicitly.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "none"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "paths"],
          "properties": {
            "kind": {"const": "files"},
            "paths": {
              "description": "Each file must exist after the run, and differ from before it.",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/theatrePath"}
            }
          }
        }
      ]
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "state": {
      "title": "State",
      "description": "Derived, never recorded: ended (its end is recorded), running (its perform is alive in this clone), interrupted (its perform has gone without recording an end), or unfinished-elsewhere (it was started in another clone, so this clone can't tell).",
      "enum": ["running", "ended", "interrupted", "unfinished-elsewhere"]
    },
    "outcome": {
      "enum": ["succeeded", "failed", "cancelled", "timed-out", "crashed", "could-not-start"]
    },
    "summary": {
      "title": "Run summary",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId", "actor", "startedBy", "runner", "stage", "effectCheck", "state", "outcome", "error",
        "events", "startedAt", "endedAt", "transcript", "stderr", "recording"
      ],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"},
        "actor": {"$ref": "#/$defs/actorName"},
        "startedBy": {"$ref": "../lineage.schema.json#/$defs/actor"},
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested", "reported"],
          "properties": {
            "requested": {"$ref": "#/$defs/runnerName"},
            "reported": {
              "description": "The runner's name and version from its init event; null when it sent none.",
              "oneOf": [
                {"type": "null"},
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "version"],
                  "properties": {
                    "name": {"type": "string", "minLength": 1},
                    "version": {"type": "string", "minLength": 1}
                  }
                }
              ]
            }
          }
        },
        "stage": {"$ref": "../lineage.schema.json#/$defs/stage"},
        "effectCheck": {"$ref": "#/$defs/effectCheck"},
        "state": {"$ref": "#/$defs/state"},
        "outcome": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/outcome"}]},
        "error": {"oneOf": [{"type": "null"}, {"$ref": "../error.schema.json"}]},
        "events": {"description": "How many run events are recorded.", "type": "integer", "minimum": 0},
        "startedAt": {"$ref": "#/$defs/timestamp"},
        "endedAt": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
        "transcript": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
        "stderr": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
        "recording": {
          "description": "null unless recording the run's events failed: then the first seq that wasn't recorded, and why.",
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["failedAt", "error"],
              "properties": {
                "failedAt": {"type": "integer", "minimum": 0},
                "error": {"$ref": "../error.schema.json"}
              }
            }
          ]
        }
      }
    },
    "loggedEvent": {
      "title": "Logged run event",
      "description": "One run event as it was recorded: the runner's event, or troupe's oversized stand-in for it, and when troupe recorded it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "runId", "seq", "at", "event"],
      "properties": {
        "kind": {"const": "event"},
        "runId": {"$ref": "#/$defs/runId"},
        "seq": {"type": "integer", "minimum": 0},
        "at": {"$ref": "#/$defs/timestamp"},
        "event": {"$ref": "../runner/run-event.schema.json#/$defs/hostEvent"}
      }
    },
    "noticeUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "notice"],
      "properties": {
        "kind": {"const": "notice"},
        "notice": {"$ref": "../notice.schema.json"}
      }
    }
  }
}
