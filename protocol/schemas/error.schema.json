  "$defs": {
    "fields": {
      "title": "Error fields",
      "description": "The fields every error and notice has. Each catalogue of codes closes the object and says what each code's details are.",
      "type": "object",
      "required": [
        "code",
        "problem",
        "fix"
      ],
      "properties": {
        "code": {
          "title": "Code",
          "description": "Stable, dotted identifier for this kind of error, such as usage.unknown-command. Surfaces use it to recognise and rephrase the error.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
        },
        "problem": {
          "title": "Problem",
          "description": "What went wrong, pointing at the real cause.",
          "type": "string",
          "minLength": 1
        },
        "fix": {
          "title": "Fix",
          "description": "What the user can do about it.",
          "type": "string",
          "minLength": 1
        },
        "path": {
          "title": "Path",
          "description": "The absolute path of the file or directory concerned, when there is one.",
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
