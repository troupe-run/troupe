{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://troupe.run/protocol/events/run-reported.schema.json",
  "title": "Run.Reported",
  "description": "The payload of one run event (topic troupe.core.runs.aggregate:Run.Reported): the runner's seq, and the event as troupe received it, or the oversized event troupe wrote in its place.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lineage",
    "timestamp",
    "seq",
    "event"
  ],
  "properties": {
    "lineage": {
      "$ref": "../lineage.schema.json"
    },
    "timestamp": {
      "$ref": "../event-record.schema.json#/$defs/libraryTimestamp"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "event": {
      "$ref": "../runner/run-event.schema.json#/$defs/hostEvent"
    }
  }
}
