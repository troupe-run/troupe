{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://troupe.run/protocol/notice.schema.json",
  "title": "Notice",
  "description": "Something a person should know while troupe works, such as a wait or a retry, as structured data. It has the same fields as an error; each surface renders it in its own words, and the code identifies it. Every code troupe can produce is listed, with what its details hold.",
  "$ref": "#/$defs/fields",
  "unevaluatedProperties": false,
  "oneOf": [
    {
      "required": [
        "details"
      ],
      "properties": {
        "code": {
          "const": "run.silent"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seconds"
          ],
          "properties": {
            "seconds": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    {
      "required": [
        "details"
      ],
      "properties": {
        "code": {
          "const": "run.retrying"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attempt",
            "maxAttempts",
            "delayMs",
            "reason"
          ],
          "properties": {
            "attempt": {
              "type": "integer",
              "minimum": 1
            },
            "maxAttempts": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "delayMs": {
              "type": "integer",
              "minimum": 0
            },
            "reason": {
              "$ref": "runner/run-event.schema.json#/$defs/retry/properties/reason"
            }
          }
        }
      }
    },
    {
      "required": [
        "details"
      ],
      "properties": {
        "code": {
          "const": "events.other-branch"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "branch",
            "session"
          ],
          "properties": {
            "branch": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "session": {
              "$ref": "lineage.schema.json#/$defs/ulid"
            }
          }
        }
      }
    },
    {
      "required": [
        "details"
      ],
      "properties": {
        "code": {
          "const": "events.order-rebuilt"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gone"
          ],
          "properties": {
            "gone": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    {
      "required": [
        "details"
      ],
      "properties": {
        "code": {
          "const": "events.incomplete-batch"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "line"
          ],
          "properties": {
            "line": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    {
      "required": [
        "details"
      ],
      "properties": {
        "code": {
          "const": "run.cancelling"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "presses"
          ],
          "properties": {
            "presses": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    {
      "required": [
        "details"
      ],
      "properties": {
        "code": {
          "const": "run.interrupted"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run"
          ],
          "properties": {
            "run": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    {
      "required": [
        "details"
      ],
      "properties": {
        "code": {
          "const": "run.unfinished-elsewhere"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run"
          ],
          "properties": {
            "run": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "fields": {
      "title": "Notice fields",
      "description": "The fields every notice has: the same as an error's.",
      "type": "object",
      "required": [
        "code",
        "problem",
        "fix"
      ],
      "properties": {
        "code": {
          "title": "Code",
          "description": "Stable, dotted identifier for this kind of notice, such as run.silent. Surfaces use it to recognise and rephrase the notice.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
        },
        "problem": {
          "title": "Problem",
          "description": "What is happening.",
          "type": "string",
          "minLength": 1
        },
        "fix": {
          "title": "Fix",
          "description": "What the person can do about it, if anything.",
          "type": "string",
          "minLength": 1
        },
        "path": {
          "title": "Path",
          "description": "The absolute path of the file or directory concerned, when there is one.",
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
