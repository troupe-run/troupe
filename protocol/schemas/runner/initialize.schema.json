{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://troupe.run/protocol/runner/initialize.schema.json",
  "title": "initialize",
  "description": "The host's first message: the protocol versions it supports. The runner answers with the version it chose, or with an error naming the versions it supports.",
  "type": "object",
  "additionalProperties": false,
  "required": ["jsonrpc", "id", "method", "params"],
  "properties": {
    "jsonrpc": {"$ref": "jsonrpc.schema.json#/$defs/jsonrpc"},
    "id": {"$ref": "jsonrpc.schema.json#/$defs/id"},
    "method": {"const": "initialize"},
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersions", "host"],
      "properties": {
        "protocolVersions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "host": {"$ref": "jsonrpc.schema.json#/$defs/named"}
      }
    }
  },
  "$defs": {
    "result": {
      "title": "initialize result",
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "runner", "capabilities"],
      "properties": {
        "protocolVersion": {"type": "integer", "minimum": 1},
        "runner": {"$ref": "jsonrpc.schema.json#/$defs/named"},
        "capabilities": {
          "description": "Optional features, by name. Version 1 defines none as required.",
          "type": "object",
          "additionalProperties": {"type": "boolean"}
        }
      }
    }
  }
}
