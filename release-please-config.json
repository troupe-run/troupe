{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.11.2/schemas/config.json",
  "bump-minor-pre-major": true,
  "include-component-in-tag": true,
  "signoff": "troupe-run-release[bot] <341990208+troupe-run-release[bot]@users.noreply.github.com>",
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "troupe",
      "components": [
        "troupe",
        "troupe-artifacts-local",
        "troupe-identity-local",
        "troupe-stage-local",
        "troupe-store-text",
        "troupe-vcs-files",
        "troupe-vcs-git",
        "protocol"
      ]
    }
  ],
  "packages": {
    "packages/troupe": {
      "release-type": "python",
      "package-name": "troupe",
      "component": "troupe",
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='troupe')].version"
        }
      ]
    },
    "packages/troupe-artifacts-local": {
      "release-type": "python",
      "package-name": "troupe-artifacts-local",
      "component": "troupe-artifacts-local",
      "extra-files": [
