{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.6.0/schemas/config.json",
  "bump-minor-pre-major": true,
  "prerelease": true,
  "commit-batch-size": 100,
  "commit-search-depth": 1000,
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance Improvements" },
    { "type": "revert", "section": "Reverts" },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "deps", "section": "Dependencies", "hidden": true },
    { "type": "style", "section": "Styles", "hidden": true },
    { "type": "chore", "section": "Miscellaneous Chores", "hidden": true },
    { "type": "refactor", "section": "Code Refactoring", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build System", "hidden": true },
    { "type": "ci", "section": "Continuous Integration", "hidden": true }
  ],
  "initial-version": "0.1.0",
  "include-component-in-tag": true,
  "signoff": "troupe-run-release[bot] <341990208+troupe-run-release[bot]@users.noreply.github.com>",
  "packages": {
    "packages/troupe": {
      "release-type": "python",
      "package-name": "troupe",
      "component": "troupe",
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='troupe')].version"
        }
      ]
    },
    "packages/troupe-artifacts-local": {
      "release-type": "python",
      "package-name": "troupe-artifacts-local",
      "component": "troupe-artifacts-local",
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='troupe-artifacts-local')].version"
        }
      ]
    },
    "packages/troupe-identity-local": {
      "release-type": "python",
      "package-name": "troupe-identity-local",
      "component": "troupe-identity-local",
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='troupe-identity-local')].version"
        }
      ]
    },
    "packages/troupe-plugin-sdk": {
      "release-type": "python",
      "package-name": "troupe-plugin-sdk",
      "component": "troupe-plugin-sdk",
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='troupe-plugin-sdk')].version"
        }
      ]
    },
    "packages/troupe-run": {
      "release-type": "python",
      "package-name": "troupe-run",
      "component": "troupe-run",
      "exclude-paths": ["packages/troupe-run"],
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='troupe-run')].version"
        },
        {
          "type": "generic",
          "path": "/README.md"
        },
        {
          "type": "generic",
          "path": "/docs/opening-night/install.md"
        }
      ]
    },
    "packages/troupe-stage-local": {
      "release-type": "python",
      "package-name": "troupe-stage-local",
      "component": "troupe-stage-local",
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='troupe-stage-local')].version"
        }
      ]
    },
    "packages/troupe-store-text": {
      "release-type": "python",
      "package-name": "troupe-store-text",
      "component": "troupe-store-text",
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='troupe-store-text')].version"
        }
      ]
    },
    "packages/troupe-vcs-files": {
      "release-type": "python",
      "package-name": "troupe-vcs-files",
      "component": "troupe-vcs-files",
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='troupe-vcs-files')].version"
        }
      ]
    },
    "packages/troupe-vcs-git": {
      "release-type": "python",
      "package-name": "troupe-vcs-git",
      "component": "troupe-vcs-git",
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='troupe-vcs-git')].version"
        }
      ]
    },
    "plugins/runner-claude-code": {
      "release-type": "python",
      "package-name": "troupe-runner-claude-code",
      "component": "troupe-runner-claude-code",
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='troupe-runner-claude-code')].version"
        }
      ]
    },
    "plugins/runner-scripted": {
      "release-type": "python",
      "package-name": "troupe-runner-scripted",
      "component": "troupe-runner-scripted",
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='troupe-runner-scripted')].version"
        }
      ]
    },
    "protocol": {
      "release-type": "simple",
      "component": "protocol",
      "extra-files": [
        {
          "type": "json",
          "path": "/packages/troupe/src/troupe/protocol/version.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
