{
  "threshold": 60.0,
  "tolerance": 0.0,
  "min_mutants": 10,
  "budget_minutes": 240,
  "pr_budget_minutes": 45,
  "max_new_issues": 5,
  "max_children": 2,
  "mutant_memory_mb": 2048,
  "full_refresh_days": 28,
  "tools": {
    "mutmut": "3.8.1",
    "stryker": "10.1.1"
  },
  "repositories": {
    "troupe": {
      "tool": "mutmut",
      "units": [
        {
          "name": "troupe",
          "source": "packages/troupe/src",
          "tests": "packages/troupe/tests",
          "deselect": [
            {
              "test": "packages/troupe/tests/test_cli_startup.py::test_importing_the_command_line_loads_none_of_the_heavy_modules",
              "why": "mutmut's hooks import email and importlib.metadata into the test process, which this test counts as heavy (trial, 2026-11-18)."
            },
            {
              "test": "packages/troupe/tests/test_config_schemas.py::test_the_models_are_what_the_schemas_generate",
              "why": "It compares the generated models with the source, which in mutmut's copy is the mutated one (trial, 2026-11-18)."
            },
            {
              "test": "packages/troupe/tests/test_package.py::test_the_built_wheel_carries_the_recorded_protocol_version_and_every_schema",
              "why": "uv build can't build the package from mutmut's copy (trial, 2026-11-18)."
            }
          ]
        },
        {
          "name": "troupe-plugin-sdk",
          "source": "packages/troupe-plugin-sdk/src",
          "tests": "packages/troupe-plugin-sdk/tests"
        },
        {
          "name": "troupe-store-text",
          "source": "packages/troupe-store-text/src",
          "tests": "packages/troupe-store-text/tests"
        },
        {
          "name": "troupe-vcs-git",
          "source": "packages/troupe-vcs-git/src",
          "tests": "packages/troupe-vcs-git/tests"
        },
        {
          "name": "troupe-vcs-files",
          "source": "packages/troupe-vcs-files/src",
          "tests": "packages/troupe-vcs-files/tests"
        },
        {
          "name": "troupe-artifacts-local",
          "source": "packages/troupe-artifacts-local/src",
          "tests": "packages/troupe-artifacts-local/tests"
        },
        {
          "name": "troupe-identity-local",
          "source": "packages/troupe-identity-local/src",
          "tests": "packages/troupe-identity-local/tests"
        },
        {
          "name": "troupe-stage-local",
          "source": "packages/troupe-stage-local/src",
          "tests": "packages/troupe-stage-local/tests"
        }
      ]
    }
  }
}
